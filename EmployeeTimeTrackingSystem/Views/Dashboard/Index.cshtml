@model EmployeeTimeTrackingSystem.Models.DashboardCardViewModel

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string now = DateTime.Now.ToString("dddd, MMMM dd, yyyy – h:mm tt");
}

<link rel="stylesheet" href="~/Content/Styles/DashboardStyle.css" />
<link rel="stylesheet" href="~/Content/Styles/ValidationStyle.css" />

<div class="dashboard-header">
    <div class="header-left">
        <h2>Dashboard</h2>
        <div class="welcome">Welcome back, @(Session["RealName"] ?? "Guest")! Here's what's happening today.</div>
    </div>
    <div class="date">@now</div>
</div>
<div id="dashboard-cards"></div>

@section scripts {
    <script>
        async function loadDashboardCards() {
            const html = await requestAsyncWithRetry('/Dashboard/Cards', {}, 'GET', {
                retries: 2,
                timeout: 8000,
                showSpinner: true
            });

            if (html) {
                $('#dashboard-cards').html(html);
            } else {
                $('#dashboard-cards').html('<div class="alert alert-danger">Failed to load dashboard data.</div>');
            }
        }

        $(document).ready(function () {
            loadDashboardCards();
        });
    </script>
}
